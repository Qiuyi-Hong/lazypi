{
  "name": "@qiuyihong/lazypi",
  "version": "0.1.1",
  "description": "LazyVim-inspired package manager for Pi",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extensions",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/lazypi.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'extensions/**/*.ts' 'src/**/*.ts' 'test/**/*.ts' '*.json' '*.md' 'docs/architecture.md'",
    "format:check": "prettier --check 'extensions/**/*.ts' 'src/**/*.ts' 'test/**/*.ts' '*.json' '*.md' 'docs/architecture.md'"
  }
}
